---
import Layout from '../layouts/Layout.astro';
import InnerHero from '../components/InnerHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { pricing } from '../i18n/pages';
import { ui } from '../i18n/ui';
import { url, type Lang } from '../i18n/routes';
import { APP_URL, SITE_NAME, LOGIN_URL } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = pricing[lang];
const t = ui[lang].common;
const crumbs = [{ name: t.breadcrumbHome, href: url('home', lang) }, { name: c.eyebrow, href: url('pricing', lang) }];
const ld = [{ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: SITE_NAME, description: c.metaDesc, url: APP_URL, applicationCategory: 'BusinessApplication' }];
---
<Layout title={c.metaTitle} description={c.metaDesc} lang={lang} routeKey="pricing" breadcrumbs={crumbs} jsonLd={ld}>
  <InnerHero eyebrow={c.eyebrow} title={c.h1} lead={c.lead} />

  <section class="section !pt-4">
    <div class="wrap max-w-[900px]">
      <article class="plan plan-main spot" data-reveal>
        <span class="plan-badge">{lang === 'es' ? 'Consulta personalizada' : 'Personalized inquiry'}</span>
        <h2>{c.heading}</h2>
        <p class="plan-desc">{lang === 'es' ? 'Revisemos el alcance que necesitás y qué módulos están disponibles para empezar.' : 'Let’s review what you need and which modules are available to get started.'}</p>
        <a href={url('contact', lang)} data-magnetic class="btn btn-primary btn-lg mt-8">{c.cta} <Icon name="arrow-right" class="arrow" /></a>
        <ul class="plan-list">
          {c.items.map((i) => <li><Icon name="check" size={16} stroke={2.5} />{i}</li>)}
        </ul>
        <a href={LOGIN_URL} class="mt-6 inline-block text-sm text-fg-2 underline decoration-line-strong underline-offset-4 hover:text-white">{ui[lang].nav.login}</a>
      </article>
    </div>
  </section>

  <Faq title={c.faqTitle} items={c.faq} />
  <CtaBand title={ui[lang].nav.login} primary={t.createAccount} />
</Layout>
<style is:global>
  .plan { padding: clamp(1.8rem, 3vw, 2.6rem); border-radius: 28px; background: linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.015)); box-shadow: inset 0 0 0 1px var(--color-line), inset 0 1px 0 rgba(255,255,255,.06); }
  .plan-main { background: radial-gradient(120% 80% at 50% 0%, rgba(183,243,74,.18), rgba(255,255,255,.02) 70%); box-shadow: inset 0 0 0 1px rgba(210,255,115,.3), inset 0 1px 0 rgba(255,255,255,.1), 0 50px 120px -50px rgba(183,243,74,.45); }
  .plan h2 { margin-top: 1.2rem; font-size: 1.4rem; font-weight: 600; letter-spacing: -.03em; }
  .plan-badge { display: inline-block; padding: 4px 12px; border-radius: 99px; font-size: .75rem; font-weight: 600; color: #11170a; background: var(--color-accent); }
  .plan-desc { margin-top: .9rem; color: var(--color-fg-2); line-height: 1.6; max-width: 50ch; }
  .plan-list { list-style: none; margin: 2rem 0 0; padding: 2rem 0 0; border-top: 1px solid var(--color-line); display: grid; gap: .85rem; }
  .plan-list li { display: flex; align-items: center; gap: .75rem; font-size: .95rem; color: var(--color-fg); }
  .plan-list svg { flex: none; color: var(--color-ok); }
</style>

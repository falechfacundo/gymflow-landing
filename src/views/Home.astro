---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Showcase from '../components/Showcase.astro';
import Bento from '../components/Bento.astro';
import Flow from '../components/Flow.astro';
import Details from '../components/Details.astro';
import CTA from '../components/CTA.astro';
import type { Lang } from '../i18n/routes';
import { APP_URL, SITE_NAME } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const meta = {
  es: {
    title: 'GymFlow — Gestión para gimnasios',
    description: 'Gestioná socios, membresías y accesos desde un mismo lugar. GymFlow conecta la operación diaria de tu gimnasio.',
    desc: 'Sistema de gestión para gimnasios con socios, membresías, control de acceso, clases y caja.',
  },
  en: {
    title: 'GymFlow — Gym management software',
    description: 'Manage members, memberships and access in one place. GymFlow connects the daily operations of your gym.',
    desc: 'Gym management software for members, memberships, access control, classes and cash.',
  },
}[lang];
const ld = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: SITE_NAME, applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: meta.desc, url: APP_URL },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: new URL(lang === 'es' ? '/' : '/en/', Astro.site).href, inLanguage: lang },
];
---
<Layout title={meta.title} description={meta.description} lang={lang} routeKey="home" jsonLd={ld}>
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <Showcase lang={lang} />
  <Bento lang={lang} />
  <Flow lang={lang} />
  <Details lang={lang} />
  <CTA lang={lang} />
</Layout>

---
interface Props { size?: number; word?: boolean; class?: string; animate?: boolean }
const { size = 28, word = true, class: cls = '', animate = false } = Astro.props;
---
<span class={`inline-flex items-center gap-[0.55em] ${cls}`} style={`font-size:${size}px`}>
  <svg viewBox="0 0 32 32" style="height:1em;width:1em;overflow:visible;color:var(--color-accent)" fill="none" aria-hidden="true" class={animate ? 'logo-anim' : ''}>
    <path d="M3 12v8M7 9v14M7 16h18M25 9v14M29 12v8" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
  </svg>
  {word && <span class="font-semibold tracking-[-0.045em] leading-none" style="font-size:.86em">GymFlow</span>}
  {!word && <span class="sr-only">GymFlow</span>}
</span>
